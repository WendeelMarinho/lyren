# --- Authentication -----------------------------------------------------------
# A shared deployment uses a principals file: it gives per-person attribution,
# per-person quotas and the ability to revoke one key without rotating everyone's.
LYREN_PRINCIPALS_FILE=principals.json

# Local development only. Every listed hash maps to one unrestricted "dev" principal,
# so there is no attribution and no individual revocation. The API refuses this
# outside LYREN_ENVIRONMENT=local.
#   KEY=$(openssl rand -hex 32); echo "$KEY"; printf %s "$KEY" | sha256sum
# Comma-separated hashes. Only hashes, never keys.
LYREN_API_KEY_HASHES=

# --- Direct sign-up (email + password) ----------------------------------------
# Where password hashes live until the database arrives. Git-ignored; mode 600.
LYREN_CREDENTIALS_FILE=credentials.json
# Sign-up is restricted to addresses already declared under a principal's "emails".
# Failed attempts are throttled per address: argon2 is deliberately expensive, so
# sign-in is also a denial-of-service surface on a small CPU budget.
LYREN_LOGIN_MAX_ATTEMPTS=5
LYREN_LOGIN_ATTEMPT_WINDOW_SECONDS=300

# --- Browser sign-in (Google) -------------------------------------------------
# Needed only by the web interface; the API works with keys alone.
# Signing in proves identity, it does not grant access: a verified address must
# already be listed under a principal's "emails" or sign-in is refused.
LYREN_GOOGLE_CLIENT_ID=
# Restrict to Workspace domains, comma-separated. Empty permits any verified
# Google account that a principal already claims.
LYREN_GOOGLE_ALLOWED_DOMAINS=
# Signs session tokens. At least 32 characters:  openssl rand -hex 32
LYREN_SESSION_SECRET=
# Also the revocation window: a signed token cannot be withdrawn before it expires,
# so disabling a principal takes effect within one TTL rather than instantly.
LYREN_SESSION_TTL_SECONDS=1800

LYREN_ENVIRONMENT=local
LYREN_LOG_LEVEL=INFO

# --- Spend --------------------------------------------------------------------
# Binds the whole deployment. The sum of per-principal quotas does not bound the
# bill, so this is the cap that protects the shared budget.
LYREN_DEPLOYMENT_CALLS_PER_DAY=2000

# Never let a router fall back to a billing provider without saying so here.
LYREN_ALLOW_PAID_PROVIDERS=false
LYREN_MAX_OUTPUT_TOKENS=1024
LYREN_REQUEST_TIMEOUT_SECONDS=120

# --- OCI Generative AI --------------------------------------------------------
# Every on-demand call bills, so this stays off until you opt in.
LYREN_OCI_ENABLED=false
LYREN_OCI_COMPARTMENT_ID=
LYREN_OCI_REGION=sa-saopaulo-1
# security_token expires in 60 minutes; api_key does not; instance_principal on the host.
LYREN_OCI_AUTH_MODE=api_key
LYREN_OCI_CONFIG_PROFILE=LYREN

# --- Local inference (llama.cpp) ------------------------------------------------
# The only provider on which prompt content never leaves this host. Probed at
# startup: a server that is down or holding no model is skipped, not failed over to.
LYREN_LOCAL_ENABLED=false
LYREN_LOCAL_BASE_URL=http://127.0.0.1:8080
# Which GGUF the server has loaded. Declared, never inferred — attributing a
# benchmark to the wrong model silently is worse than refusing to guess.
LYREN_LOCAL_MODEL_ID=local/unspecified

# --- Cache --------------------------------------------------------------------
# off | record | replay | auto
LYREN_CACHE_MODE=auto
LYREN_CACHE_DIR=.lyren-cache
